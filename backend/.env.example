# PostgreSQL local development examples only. Do not commit real secrets.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerdock
DB_USERNAME=careerdock
DB_PASSWORD=careerdock_dev_password

SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth. Fill real values only in local/production secret storage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# 자격번호 암호화 키. Base64로 인코딩한 32바이트 값.
# 예: openssl rand -base64 32
# 운영 키는 절대 커밋하지 않는다. 키를 바꾸면 기존 자격번호는 복호화할 수 없다.
CREDENTIAL_ENCRYPTION_KEY=Y2FyZWVyZG9jay1sb2NhbC1kZXYta2V5LTMyYnl0ZXM=

# Local development can use false/Lax. Production should use true/None behind HTTPS when cross-site cookies are needed.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
