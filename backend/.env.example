# PostgreSQL local development examples only. Do not commit real secrets.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerdock
DB_USERNAME=careerdock
DB_PASSWORD=careerdock_dev_password

SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth. Fill real values only in local/production secret storage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Google Calendar 연동(로그인과 별개 scope). 같은 GOOGLE_CLIENT_ID/SECRET을 재사용하되,
# 이 redirect URI를 Google Cloud Console에 별도로 추가 등록해야 한다.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/calendar/oauth/callback
# Google Refresh/Access Token 암호화 키. Base64로 인코딩한 32바이트 값.
# 예: openssl rand -base64 32 — CREDENTIAL_ENCRYPTION_KEY와 반드시 다른 값을 쓴다.
GOOGLE_TOKEN_ENCRYPTION_KEY=Y2FyZWVyZG9jay1sb2NhbC10b2tlbi1rZXktMzJieXg=

# 자격번호 암호화 키. Base64로 인코딩한 32바이트 값.
# 예: openssl rand -base64 32
# 운영 키는 절대 커밋하지 않는다. 키를 바꾸면 기존 자격번호는 복호화할 수 없다.
CREDENTIAL_ENCRYPTION_KEY=Y2FyZWVyZG9jay1sb2NhbC1kZXYta2V5LTMyYnl0ZXM=

# 업로드 파일 본문 저장 위치. 운영에서는 컨테이너 밖 볼륨 경로를 넣는다.
# 공개 웹 루트 아래에 두면 안 된다. 다운로드는 항상 API를 거친다.
FILE_STORAGE_PATH=./data/files
# 한 파일당 최대 크기. 초과하면 400 FILE_ERROR.
# 요청 전체 한도는 폼 필드 몫만큼 더 크게 잡는다. 파일 한도를 올리면 둘 다 올린다.
MAX_UPLOAD_SIZE=10MB
MAX_UPLOAD_REQUEST_SIZE=11MB

# Local development can use false/Lax. Production should use true/None behind HTTPS when cross-site cookies are needed.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
