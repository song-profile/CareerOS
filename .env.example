# Spring Boot API base URL. 실제 비밀값은 작성하지 않는다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-side API URL for the Next.js container. Local non-Docker runs can omit this.
API_INTERNAL_BASE_URL=http://backend:8080

# Spring Security Google OAuth start endpoint.
NEXT_PUBLIC_GOOGLE_OAUTH_START_PATH=/oauth2/authorization/google

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerdock
DB_USERNAME=careerdock
DB_PASSWORD=change-me

# Backend runtime
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth. Do not commit real values.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/calendar/oauth/callback

# Base64-encoded 32-byte keys. Generate real values for each environment.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# File storage
FILE_STORAGE_PATH=/app/data/files
MAX_UPLOAD_SIZE=10MB
MAX_UPLOAD_REQUEST_SIZE=11MB

# Local development can use false/Lax. Production over HTTPS should use true/None.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
